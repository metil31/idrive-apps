{
  "id": "waze-eta-reader",
  "kind": "tool",
  "version": "0.3.2",
  "title": "Waze CarPlay Reader",
  "description": "Local reader for Waze ETA and maneuvers on iOS CarPlay.",
  "mguHmi": ["ID7"],
  "uninstallable": true,
  "files": [
    { "path": "reader.js", "mode": "0644" },
    { "path": "ocr.js", "mode": "0644" },
    { "path": "eta-atlas.json", "mode": "0644" },
    { "path": "OFL-Inter.txt", "mode": "0644" },
    { "path": "LICENSE", "mode": "0644" }
  ],
  "units": [{ "name": "waze-eta-reader.service" }],
  "enable": [{ "unit": "waze-eta-reader.service", "target": "oapcontroller.service" }],
  "recmgr": ["waze-eta-reader"],
  "restart": ["waze-eta-reader.service"]
}
