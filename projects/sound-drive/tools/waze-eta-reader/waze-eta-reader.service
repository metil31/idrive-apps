[Unit]
Description=Waze ETA diagnostic reader
RequiresMountsFor=/var/opt
After=winston.service vsomeipd.service oapcontroller.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=root
UMask=0077
RuntimeDirectory=waze-eta-reader
RuntimeDirectoryMode=0755
Environment=WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=/run/wayland
ExecStart=/usr/bin/node /var/opt/waze-eta-reader/current/reader.js
Restart=on-failure
RestartSec=10
Nice=10
Slice=standard.slice

[Install]
WantedBy=oapcontroller.service
