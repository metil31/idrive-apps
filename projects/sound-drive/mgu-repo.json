{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "exclude": ["drive_coach"],
    "manifest": "app.json",
    "icon": "icon.png",
    "build": {
      "python": "kit/tools/build.py",
      "args": [
        "{id}"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "shared": [
        "LICENSE",
        "kit/runtime",
        "kit/platform",
        "kit/localization",
        "kit/tools/build.py",
        "kit/tools/pack_data.py",
        "kit/tools/localize.py",
        "kit/tools/locale-revisions.json",
        "kit/tools/oapgen",
        "oap-sdk"
      ]
    }
  },
  "tools": [
    {
      "id": "iconix-audiod",
      "path": "tools/iconix-audiod",
      "title": "Sound Drive Audio",
      "description": "Serviciu audio experimental pentru Sound Drive",
      "optional": true,
      "uninstallable": true,
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    }
  ]
}
