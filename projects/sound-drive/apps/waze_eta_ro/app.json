  },
  "screens": [{
    "name": "MAIN", "kind": "menu", "settings": true, "title": "Waze ETA",
    "items": [
      ["header", "WE_TEST", "Test Waze"],
      ["button", "WE_START", "Pornește testul · 30 min"],
      ["button", "WE_STOP", "Oprește testul"],
      ["text", "WE_STATUS", "Stare"],
      ["text", "WE_ETA", "Sosire estimată"],
      ["header", "WE_HUD_HEAD", "HUD"],
      ["checkbox", "WE_HUD", "Arată ETA pe HUD"],
      ["slider", "WE_SIZE", "Mărime pe HUD", 6],
      ["text", "WE_POS", "Poziție"],
      ["button", "WE_LEFT", "Mută la stânga"],
      ["button", "WE_RIGHT", "Mută la dreapta"],
      ["button", "WE_UP", "Mută în sus"],
      ["button", "WE_DOWN", "Mută în jos"],
      ["button", "WE_RESET", "Poziție implicită"]
    ]
  }],
  "settings": [
    { "key": "hud", "label": "Arată ETA pe HUD", "type": "bool", "default": false, "hidden": true },
    { "key": "size", "label": "Mărime pe HUD", "type": "number", "default": 3, "hidden": true },
    { "key": "x", "label": "Stânga / dreapta", "type": "number", "default": 220, "hidden": true },
    { "key": "y", "label": "Sus / jos", "type": "number", "default": 270, "hidden": true }
  ]
}
