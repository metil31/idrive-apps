{
  "id": "waze_eta_ro",
  "title": "Waze ETA",
  "description": "Test de citire a orei sosirii din Waze, cu afișare opțională pe HUD.",
  "version": "0.1.1",
  "language": "ro",
  "license": "MIT",
  "vendor": "custom",
  "loggingId": "WETA",
