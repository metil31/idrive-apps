{
  "id": "hud_romania",
  "title": "HUD România",
  "description": "Semnalizări și sosirea estimată din CarPlay pe HUD-ul BMW iDrive 7.",
  "version": "0.1.7",
  "language": "ro",
  "license": "MIT",
  "vendor": "custom",
  "loggingId": "HUDR",
  "mguHmi": ["ID7"],
  "autostart": true,
  "requires": { "cluster-render": "0.3.7" },
  "signals": {
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "Starea READY, necesară pentru afișare",
      "VehicleCondition": "s"
    },
    "de.bmw.body.Light": {
      "_optional": "Semnalizările și avariile",
      "StatusFunctionsIndicators": "s",
      "StatusFunctionsIndicators2": "s"
    },
    "de.bmw.infotainment.navigation.projectedmodeguiding.ProjectedModeGuiding": {
      "_instances": "Main_Instance",
      "_optional": "Estimările de sosire furnizate de CarPlay",
      "waypoints": "s"
    },
    "de.bmw.infotainment.navigation.guiding.Guidance": {
      "_instances": "Main_Instance",
      "_optional": "Confirmarea sursei traseului proiectat",
      "guidingProvider": "rs"
    },
    "de.bmw.infotainment.a4a.carplay.CarPlayManager": {
      "_instances": "CarPlayManagerInst1",
      "_optional": "Starea ghidajului CarPlay",
      "projectedGuidanceActive": "rs",
      "projectedGuidanceMetadataAvailable": "rs"
    }
  },
  "screens": [{
    "name": "MAIN",
    "kind": "canvas",
    "title": "HUD România",
    "buttons": [["BTN_SETTINGS", "Setări"]]
  }],
  "settings": [
    { "key": "indicators", "label": "Semnalizări și avarii", "type": "bool", "default": true },
    { "key": "indicatorX", "label": "Săgeți stânga / dreapta", "type": "number", "unit": "px", "default": 0,
      "steps": [-100, -80, -60, -40, -20, 0, 20, 40, 60, 80, 100] },
    { "key": "indicatorY", "label": "Săgeți sus / jos", "type": "number", "unit": "px", "default": 286,
      "steps": [126, 146, 166, 186, 206, 226, 246, 266, 286, 306, 326, 346, 366] },
    { "key": "indicatorGap", "label": "Distanță între săgeți", "type": "number", "unit": "px", "default": 362,
      "steps": [122, 162, 202, 242, 282, 322, 362, 402, 442, 482] },
    { "key": "eta", "label": "Estimare sosire CarPlay", "type": "bool", "default": true },
    { "key": "position", "label": "Poziție ETA pe HUD", "type": "choice", "default": "low",
      "options": [["high", "Sus"], ["middle", "Mijloc"], ["low", "Jos"]] },
    { "key": "brightness", "label": "Luminozitate", "type": "choice", "default": "normal",
      "options": [["dim", "Redusă"], ["normal", "Normală"]] }
  ]
}
