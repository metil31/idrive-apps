{
  "id": "hud_romania",
  "title": "Metil's HUD Apps",
  "description": "Turn signals and CarPlay arrival on HUD, plus media on HUD and the cluster map.",
  "version": "0.2.2",
  "language": "en",
  "license": "MIT",
  "vendor": "custom",
  "loggingId": "HUDR",
  "mguHmi": ["ID7"],
  "autostart": true,
  "requires": {
    "cluster-render": "0.3.7"
  },
  "signals": {
    "de.bmw.infrastructure.VehicleCondition": {"_optional": "Vehicle READY state", "VehicleCondition": "s"},
    "de.bmw.body.Light": {"_optional": "Turn signals and hazard lights", "StatusFunctionsIndicators": "s", "StatusFunctionsIndicators2": "s"},
    "de.bmw.infotainment.navigation.projectedmodeguiding.ProjectedModeGuiding": {"_instances": "Main_Instance", "_optional": "CarPlay arrival estimates", "waypoints": "s"},
    "de.bmw.infotainment.navigation.guiding.Guidance": {"_instances": "Main_Instance", "_optional": "Projected route provider", "guidingProvider": "rs"},
    "de.bmw.infotainment.a4a.carplay.CarPlayManager": {
      "_instances": "CarPlayManagerInst1",
      "_optional": "CarPlay guidance state",
      "projectedGuidanceActive": "rs",
      "projectedGuidanceMetadataAvailable": "rs"
    },
    "de.bmw.infotainment.entertainment.mediaplayer.MediaPlayer": {"_instances": "CarPlayMedia", "_optional": "CarPlay song title and artist", "currentItemMetadata": "rs", "playerState": "rs"},
    "de.bmw.infotainment.vehicle.Vehicle2": {"statusCarSpeed2": "rs"}
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "menu",
      "title": "Metil's HUD Apps",
      "settings": true,
      "items": [
        ["button", "HR_OPEN_MEDIA", "Media"],
        ["button", "HR_OPEN_IND", "Turn signals"],
        ["button", "HR_OPEN_ETA", "Native CarPlay ETA"],
        ["dropdown", "APP_LANGUAGE", "Language", ["English", "Romana"]],
        ["dropdown", "HR_BRIGHTNESS", "Brightness", ["Dim", "Normal"]],
        ["text", "HR_RENDERER", "Connecting to HUD"]
      ]
    },
    {
      "name": "HUD_MEDIA",
      "kind": "menu",
      "title": "Media",
      "items": [
        ["text", "MR_DEMO_STATUS", "Demo requires READY and standstill"],
        ["button", "MR_DEMO_STOP", "Stop demo"],
        ["checkbox", "MR_ENABLED", "Show song and artist"],
        ["dropdown", "MR_SHOW", "Show on", ["HUD", "Cluster", "HUD and cluster"]],
        ["checkbox", "MR_ART", "Album cover"],
        ["text", "MR_STATUS", "Status"],
        ["text", "MR_TRACK", "Now playing"],
        ["header", "MR_HUD_HEAD", "Media on HUD"],
        ["button", "MR_HUD_DEMO", "Demo media on HUD"],
        ["slider", "MR_HUD_SIZE", "HUD size", 8],
        ["text", "MR_HUD_POS", "HUD position"],
        ["button", "MR_HUD_LEFT", "Move left"],
        ["button", "MR_HUD_RIGHT", "Move right"],
        ["button", "MR_HUD_UP", "Move up"],
        ["button", "MR_HUD_DOWN", "Move down"],
        ["button", "MR_HUD_RESET", "Default position"],
        ["header", "MR_CL_HEAD", "Media on cluster map"],
        ["button", "MR_CL_DEMO", "Demo media on cluster"],
        ["slider", "MR_CL_SIZE", "Cluster size", 8],
        ["text", "MR_CL_POS", "Cluster position"],
        ["button", "MR_CL_LEFT", "Move left"],
        ["button", "MR_CL_RIGHT", "Move right"],
        ["button", "MR_CL_UP", "Move up"],
        ["button", "MR_CL_DOWN", "Move down"],
        ["button", "MR_CL_RESET", "Default position"]
      ]
    },
    {
      "name": "HUD_IND",
      "kind": "menu",
      "title": "Turn signals",
      "items": [
        ["text", "HR_IND_DEMO_STATUS", "Demo requires READY and standstill"],
        ["button", "HR_IND_DEMO_STOP", "Stop demo"],
        ["checkbox", "HR_IND", "Show turn signals and hazards"],
        ["text", "HR_IND_STATUS", "Indicators inactive"],
        ["button", "HR_IND_DEMO", "Demo turn signals"],
        ["text", "HR_POSITION", "Position"],
        ["button", "HR_LEFT", "Move left"],
        ["button", "HR_RIGHT", "Move right"],
        ["button", "HR_UP", "Move up"],
        ["button", "HR_DOWN", "Move down"],
        ["button", "HR_NARROW", "Move arrows closer"],
        ["button", "HR_WIDEN", "Move arrows apart"],
        ["button", "HR_RESET", "Reset position and spacing"]
      ]
    },
    {
      "name": "HUD_ETA",
      "kind": "menu",
      "title": "Native CarPlay ETA",
      "items": [
        ["text", "HR_ETA_SOURCE", "Uses route data sent to iDrive. For Waze, use Waze ETA iOS."],
        ["text", "HR_ETA_DEMO_STATUS", "Demo requires READY and standstill"],
        ["button", "HR_ETA_DEMO_STOP", "Stop demo"],
        ["checkbox", "HR_ETA", "Show estimated arrival"],
        ["text", "HR_ETA_STATUS", "Waiting for CarPlay"],
        ["text", "HR_ETA_DETAIL", "CarPlay route status"],
        ["button", "HR_ETA_DEMO", "Demo CarPlay arrival"],
        ["dropdown", "HR_ETA_POSITION", "ETA position", ["High", "Middle", "Low"]]
      ]
    }
  ],
  "settings": [
    {
      "key": "menuLanguage",
      "label": "Language",
      "type": "choice",
      "default": "en",
      "options": [["en", "English"], ["ro", "Romana"]],
      "hidden": true
    },
    {"key": "indicators", "label": "Semnalizari si avarii", "type": "bool", "default": true, "hidden": true},
    {"key": "indicatorX", "label": "Sageti stanga / dreapta", "type": "number", "unit": "px", "default": 0, "hidden": true},
    {"key": "indicatorY", "label": "Sageti sus / jos", "type": "number", "unit": "px", "default": 286, "hidden": true},
    {"key": "indicatorGap", "label": "Distanta intre sageti", "type": "number", "unit": "px", "default": 362, "hidden": true},
    {"key": "eta", "label": "Estimare sosire CarPlay", "type": "bool", "default": true, "hidden": true},
    {
      "key": "position",
      "label": "Pozitie ETA pe HUD",
      "type": "choice",
      "default": "low",
      "options": [["high", "High"], ["middle", "Middle"], ["low", "Low"]],
      "hidden": true
    },
    {
      "key": "brightness",
      "label": "Brightness",
      "type": "choice",
      "default": "normal",
      "options": [["dim", "Dim"], ["normal", "Normal"]],
      "hidden": true
    },
    {"key": "mediaEnabled", "label": "Show song and artist", "type": "bool", "default": false, "hidden": true},
    {
      "key": "mediaShow",
      "label": "Show on",
      "type": "choice",
      "default": "hud",
      "hidden": true,
      "options": [["hud", "HUD"], ["cluster", "Cluster"], ["both", "HUD and cluster"]]
    },
    {"key": "mediaAlbumArt", "label": "Album cover", "type": "bool", "default": false, "hidden": true},
    {"key": "mediaPositionX", "label": "HUD stanga / dreapta", "type": "number", "unit": "px", "default": 0, "hidden": true},
    {"key": "mediaPositionY", "label": "HUD sus / jos", "type": "number", "unit": "px", "default": 350, "hidden": true},
    {
      "key": "mediaHudSize",
      "label": "HUD size",
      "type": "number",
      "unit": "%",
      "default": 100,
      "hidden": true,
      "steps": [60, 70, 80, 90, 100, 110, 120, 135, 150]
    },
    {"key": "mediaClusterX", "label": "Bord stanga / dreapta", "type": "number", "unit": "px", "default": 0, "hidden": true},
    {"key": "mediaClusterY", "label": "Bord sus / jos", "type": "number", "unit": "px", "default": 85, "hidden": true},
    {
      "key": "mediaClusterSize",
      "label": "Cluster size",
      "type": "number",
      "unit": "%",
      "default": 100,
      "hidden": true,
      "steps": [60, 70, 80, 90, 100, 110, 120, 135, 150]
    }
  ],
