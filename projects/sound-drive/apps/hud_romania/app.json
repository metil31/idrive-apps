{
  "id": "hud_romania",
  "title": "HUD România",
  "description": "Semnalizări și sosirea estimată din CarPlay pe HUD-ul BMW iDrive 7.",
  "version": "0.1.8",
  "language": "ro",
  "license": "MIT",
  "vendor": "custom",
  "loggingId": "HUDR",
  "mguHmi": ["ID7"],
  "autostart": true,
  "requires": { "cluster-render": "0.3.7" },
  "signals": {
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "Starea READY, necesară pentru afișare",
      "VehicleCondition": "s"
    },
    "de.bmw.body.Light": {
      "_optional": "Semnalizările și avariile",
      "StatusFunctionsIndicators": "s",
      "StatusFunctionsIndicators2": "s"
    },
    "de.bmw.infotainment.navigation.projectedmodeguiding.ProjectedModeGuiding": {
      "_instances": "Main_Instance",
      "_optional": "Estimările de sosire furnizate de CarPlay",
      "waypoints": "s"
    },
    "de.bmw.infotainment.navigation.guiding.Guidance": {
      "_instances": "Main_Instance",
      "_optional": "Confirmarea sursei traseului proiectat",
      "guidingProvider": "rs"
    },
    "de.bmw.infotainment.a4a.carplay.CarPlayManager": {
      "_instances": "CarPlayManagerInst1",
      "_optional": "Starea ghidajului CarPlay",
      "projectedGuidanceActive": "rs",
      "projectedGuidanceMetadataAvailable": "rs"
    }
  },
  "screens": [{
    "name": "MAIN",
    "kind": "menu",
    "title": "HUD România",
    "settings": true,
    "items": [
      ["header", "HR_IND_HEAD", "Semnalizări pe HUD"],
      ["checkbox", "HR_IND", "Afișează semnalizările și avariile"],
      ["text", "HR_IND_STATUS", "Semnalizări inactive"],
      ["text", "HR_POSITION", "Poziție"],
      ["button", "HR_LEFT", "Mută la stânga"],
      ["button", "HR_RIGHT", "Mută la dreapta"],
      ["button", "HR_UP", "Mută în sus"],
      ["button", "HR_DOWN", "Mută în jos"],
      ["button", "HR_NARROW", "Apropie săgețile"],
      ["button", "HR_WIDEN", "Depărtează săgețile"],
      ["button", "HR_RESET", "Poziție și distanță implicite"],
      ["header", "HR_ETA_HEAD", "Sosire din CarPlay"],
      ["checkbox", "HR_ETA", "Afișează ora estimată a sosirii"],
      ["text", "HR_ETA_STATUS", "Așteaptă date CarPlay"],
      ["text", "HR_ETA_DETAIL", "Stare traseu CarPlay"],
      ["dropdown", "HR_ETA_POSITION", "Poziție ETA", ["Sus", "Mijloc", "Jos"]],
      ["dropdown", "HR_BRIGHTNESS", "Luminozitate", ["Redusă", "Normală"]],
      ["text", "HR_RENDERER", "Se conectează la HUD"]
    ]
  }],
  "settings": [
    { "key": "indicators", "label": "Semnalizări și avarii", "type": "bool", "default": true, "hidden": true },
    { "key": "indicatorX", "label": "Săgeți stânga / dreapta", "type": "number", "unit": "px", "default": 0,
      "hidden": true },
    { "key": "indicatorY", "label": "Săgeți sus / jos", "type": "number", "unit": "px", "default": 286,
      "hidden": true },
    { "key": "indicatorGap", "label": "Distanță între săgeți", "type": "number", "unit": "px", "default": 362,
      "hidden": true },
    { "key": "eta", "label": "Estimare sosire CarPlay", "type": "bool", "default": true, "hidden": true },
    { "key": "position", "label": "Poziție ETA pe HUD", "type": "choice", "default": "low",
      "options": [["high", "Sus"], ["middle", "Mijloc"], ["low", "Jos"]], "hidden": true },
    { "key": "brightness", "label": "Luminozitate", "type": "choice", "default": "normal",
      "options": [["dim", "Redusă"], ["normal", "Normală"]], "hidden": true }
  ]
}
