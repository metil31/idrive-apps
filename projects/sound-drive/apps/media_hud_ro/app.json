      ["checkbox", "MR_ART", "Coperta albumului"],
      ["text", "MR_STATUS", "Stare"],
      ["text", "MR_TRACK", "În redare"],
      ["header", "MR_HUD_HEAD", "HUD"],
      ["slider", "MR_HUD_SIZE", "Mărime pe HUD", 8],
      ["text", "MR_HUD_POS", "Poziție HUD"],
      ["button", "MR_HUD_LEFT", "Mută la stânga"],
      ["button", "MR_HUD_RIGHT", "Mută la dreapta"],
      ["button", "MR_HUD_UP", "Mută în sus"],
      ["button", "MR_HUD_DOWN", "Mută în jos"],
      ["button", "MR_HUD_RESET", "Poziție implicită"],
      ["header", "MR_CL_HEAD", "Bord"],
      ["slider", "MR_CL_SIZE", "Mărime pe bord", 8],
      ["text", "MR_CL_POS", "Poziție pe bord"],
      ["button", "MR_CL_LEFT", "Mută la stânga"],
      ["button", "MR_CL_RIGHT", "Mută la dreapta"],
      ["button", "MR_CL_UP", "Mută în sus"],
      ["button", "MR_CL_DOWN", "Mută în jos"],
      ["button", "MR_CL_RESET", "Poziție implicită"]
    ]
  }],
  "settings": [
    { "key": "enabled", "label": "Afișează melodia și artistul", "type": "bool", "default": true, "hidden": true },
    { "key": "show", "label": "Afișează pe", "type": "choice", "default": "hud", "hidden": true,
      "options": [["hud", "HUD"], ["cluster", "Bord"], ["both", "HUD și bord"]] },
    { "key": "albumArt", "label": "Coperta albumului", "type": "bool", "default": false, "hidden": true },
    { "key": "positionX", "label": "HUD stânga / dreapta", "type": "number", "unit": "px", "default": 0, "hidden": true },
    { "key": "positionY", "label": "HUD sus / jos", "type": "number", "unit": "px", "default": 350, "hidden": true },
    { "key": "hudSize", "label": "Mărime pe HUD", "type": "number", "unit": "%", "default": 100, "hidden": true,
      "steps": [60, 70, 80, 90, 100, 110, 120, 135, 150] },
    { "key": "clusterX", "label": "Bord stânga / dreapta", "type": "number", "unit": "px", "default": 0, "hidden": true },
    { "key": "clusterY", "label": "Bord sus / jos", "type": "number", "unit": "px", "default": 85, "hidden": true },
    { "key": "clusterSize", "label": "Mărime pe bord", "type": "number", "unit": "%", "default": 100, "hidden": true,
      "steps": [60, 70, 80, 90, 100, 110, 120, 135, 150] }
  ]
