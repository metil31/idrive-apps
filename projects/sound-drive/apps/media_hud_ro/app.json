{
  "id": "media_hud_ro",
  "title": "Media HUD România",
  "description": "Melodia și artistul din CarPlay pe HUD și pe harta din bord, cu poziție și mărime reglabile.",
  "version": "0.1.3",
  "language": "ro",
  "license": "MIT",
  "vendor": "custom",
  "loggingId": "MHUD",
  "mguHmi": ["ID7"],
  "autostart": true,
  "requires": { "cluster-render": "0.3.7" },
  "signals": {
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "Starea READY, necesară pentru afișare",
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.entertainment.mediaplayer.MediaPlayer": {
      "_instances": "CarPlayMedia",
      "_optional": "Titlul și artistul pentru piesa redată prin CarPlay",
      "currentItemMetadata": "rs",
      "playerState": "rs"
    }
  },
  "screens": [{
    "name": "MAIN",
    "kind": "canvas",
    "title": "Media HUD România",
    "buttons": [["BTN_SETTINGS", "Setări"]]
  }],
  "settings": [
    { "key": "enabled", "label": "Afișează melodia și artistul", "type": "bool", "default": true },
    { "key": "show", "label": "Afișează pe", "type": "choice", "default": "hud",
      "options": [["hud", "HUD"], ["cluster", "Bord"], ["both", "HUD și bord"]] },
    { "key": "albumArt", "label": "Coperta albumului", "type": "bool", "default": false },
    { "key": "positionX", "label": "HUD stânga / dreapta", "type": "number", "unit": "px", "default": 0,
      "steps": [-180, -150, -120, -90, -60, -30, 0, 30, 60, 90, 120, 150, 180] },
    { "key": "positionY", "label": "HUD sus / jos", "type": "number", "unit": "px", "default": 350,
      "steps": [110, 140, 170, 200, 230, 260, 290, 320, 350, 380, 410, 440] },
    { "key": "hudSize", "label": "Mărime pe HUD", "type": "number", "unit": "%", "default": 100,
      "steps": [60, 70, 80, 90, 100, 110, 120, 135, 150] },
    { "key": "clusterX", "label": "Bord stânga / dreapta", "type": "number", "unit": "px", "default": 0,
      "steps": [-300, -250, -200, -150, -100, -50, 0, 50, 100, 150, 200, 250, 300] },
    { "key": "clusterY", "label": "Bord sus / jos", "type": "number", "unit": "px", "default": 85,
      "steps": [45, 65, 85, 110, 140, 170, 200, 230, 260, 290, 320, 350, 380, 410, 440] },
    { "key": "clusterSize", "label": "Mărime pe bord", "type": "number", "unit": "%", "default": 100,
      "steps": [60, 70, 80, 90, 100, 110, 120, 135, 150] }
  ]
}
